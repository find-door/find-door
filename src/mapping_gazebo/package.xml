<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mapping_gazebo</name>
  <version>0.1.0</version>
  <description>Indoor Gazebo Harmonic worlds and launch files for 2D LiDAR + camera semantic mapping</description>
  <maintainer email="prophet000228@gmail.com">정원준</maintainer>
  <license>TBD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Robot model, sensors and bridge come from the research workspace (overlay). See ADR-0003. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>wf_gazebo</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
