<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9">
  <!-- scripts/door_probe/generate_worlds.py로 생성. 실제 Gazebo 기하 실험용이며 실물 문 인식 성능을 나타내지 않음. 조건=closed, 문짝 각도=0도. -->
  <world name="door_probe_v1">
