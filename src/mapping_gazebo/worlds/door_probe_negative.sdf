<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9">
  <!-- scripts/door_probe/generate_worlds.py로 생성. 실제 Gazebo 기하 실험용이며 실물 문 인식 성능을 나타내지 않음. 조건=negative, 문짝 각도=None도. -->
  <world name="door_probe_v1">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.75 0.8 1</background>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>-3 -3 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.4 0.2 -0.9</direction>
    </light>
    <model name="floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="body">
        <collision name="floor_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.52 1</ambient>
            <diffuse>0.55 0.55 0.52 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="body">
        <collision name="front_wall_collision">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 12 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="front_wall_visual">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 12 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.76 0.7 1</ambient>
            <diffuse>0.78 0.76 0.7 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
        <collision name="background_collision">
          <pose>4 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 12 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="background_visual">
          <pose>4 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 12 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.76 0.7 1</ambient>
            <diffuse>0.78 0.76 0.7 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
        <collision name="room_left_collision">
          <pose>2 -6 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>4 0.1 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="room_left_visual">
          <pose>2 -6 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>4 0.1 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.76 0.7 1</ambient>
            <diffuse>0.78 0.76 0.7 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
        <collision name="room_right_collision">
          <pose>2 6 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>4 0.1 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="room_right_visual">
          <pose>2 6 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>4 0.1 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.76 0.7 1</ambient>
            <diffuse>0.78 0.76 0.7 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
